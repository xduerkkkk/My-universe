{
	"nodes":[
		{"id":"c4189a71cafb4da3","type":"group","x":-1840,"y":140,"width":720,"height":570,"label":"TCP"},
		{"id":"15f5acac92013604","type":"group","collapsed":true,"x":-1760,"y":-320,"width":740,"height":320,"label":"DNS"},
		{
			"id":"b1a461b544dad835",
			"type":"text",
			"text":"服务端端口号：\n53",
			"styleAttributes":{},
			"x":-1440,
			"y":-240,
			"width":260,
