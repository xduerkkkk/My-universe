		{"id":"3a383bc6d7b72f77","x":-180,"y":660,"width":280,"height":112,"type":"text","text":"**定义：若 x0 某领域内，任意点 x，都有 f(x)<=f(x0) 或 f(x)>=f(x0)，则 x0 为函数极点**。   "},
		{"id":"57b8a3f90aa708c7","x":-340,"y":800,"width":131,"height":60,"type":"text","text":"极值"},
